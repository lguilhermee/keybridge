{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Keybridge: desktop development",
      "type": "shell",
      "command": "npm",
      "args": ["run", "tauri:dev"],
      "options": { "cwd": "${workspaceFolder}/apps/desktop" },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "Keybridge: frontend check",
      "type": "shell",
      "command": "npm",
      "args": ["run", "check"],
      "options": { "cwd": "${workspaceFolder}/apps/desktop" },
      "problemMatcher": []
    },
    {
      "label": "Keybridge: backend tests",
      "type": "shell",
      "command": "cargo",
      "args": ["test", "--locked", "-p", "cursor-server", "--lib"],
      "problemMatcher": []
    }
  ]
}
